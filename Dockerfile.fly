# Optimized Dockerfile for Fly.io
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8080

WORKDIR /app

# Install system dependencies (minimal for smaller image)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create non-root user for security
RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8080

# Startup script
CMD ["sh", "-c", "\
    alembic upgrade head && \
    echo '🚀 Starting CloudCost Optimizer API...' && \
    (python scripts/fetch_real_data.py || echo '⚠️  Initial data fetch failed, continuing...') && \
    (python scripts/fetch_real_spot_pricing.py || echo '⚠️  Spot pricing fetch failed, continuing...') && \
    (python scripts/add_reserved_pricing.py || echo '⚠️  Reserved pricing failed, continuing...') && \
    uvicorn src.api.main:app --host 0.0.0.0 --port 8080 \
"]
