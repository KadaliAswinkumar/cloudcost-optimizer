# ==========================================
# CloudCost Optimizer - Environment Variables
# ==========================================

# APPLICATION SETTINGS
# --------------------
APP_NAME=CloudCost Optimizer
# App mode: use ENVIRONMENT or APP_ENV (both work)
ENVIRONMENT=development
DEBUG=true  # Set to 'false' in production
SECRET_KEY=your-super-secret-key-change-in-production  # Generate with: openssl rand -base64 32

# SERVER SETTINGS (Local Development)
# ------------------------------------
HOST=0.0.0.0
PORT=8000

# DATABASE SETTINGS
# -----------------
# Local (Podman from ./setup-local.sh maps host 5433 -> Postgres 5432):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/cloudcost

# Production (Render):
# Render auto-provides DATABASE_URL, but if using external DB (e.g., Neon):
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional connection pool settings:
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# REDIS SETTINGS
# --------------
# Local Development:
REDIS_URL=redis://localhost:6379/0

# Production (Upstash - free tier):
# Get from: https://upstash.com → Your Redis → REST API section
# Format: redis://default:<TOKEN>@<HOST>:6379
# Example: REDIS_URL=redis://default:AbCdEf123456@free-kangaroo-12345.upstash.io:6379

REDIS_CACHE_TTL=3600  # Cache time-to-live in seconds

# AWS SETTINGS (Optional)
# -----------------------
# Only needed if you want to fetch live AWS pricing data
# Leave blank for demo mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region: AWS_REGION or AWS_DEFAULT_REGION (both work)
AWS_REGION=us-east-1

# GROQ (Required for CloudCost AI™ chat)
# --------------------------------------
# Create a free key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# CELERY SETTINGS (Background Jobs)
# ----------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# RATE LIMITING
# -------------
RATE_LIMIT_REQUESTS=100  # Max requests per window
RATE_LIMIT_WINDOW=60  # Time window in seconds

# CORS SETTINGS
# -------------
# Comma-separated list of allowed origins (no spaces!)
# Local Development:
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# Production (Render):
# Update after deploying frontend and backend:
# CORS_ORIGINS=https://your-backend.onrender.com,https://your-frontend.onrender.com,http://localhost:5173

# LOGGING
# -------
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | text

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# 
# FOR RENDER DEPLOYMENT:
# 1. Create PostgreSQL database in Render (free tier)
# 2. Create Upstash Redis account (free forever)
# 3. Generate SECRET_KEY: openssl rand -base64 32
# 4. Set environment variables in Render dashboard
# 5. Update CORS_ORIGINS with your deployed URLs
#
# See DEPLOY_TO_RENDER.md for complete instructions
# ==========================================

