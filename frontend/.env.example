# Local Vite dev (optional overrides)
# UI port — default 8080 (API on 8801; no 5xxx ports)
# VITE_UI_PORT=8080

# Where to proxy /api and /health (FastAPI). Default: backend on 8801
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8801

# Production / CI build only: full API URL (GitHub Pages build & local: npm run build)
# GitHub: set repository variable VITE_API_URL or rely on default in .github/workflows/deploy.yml
# VITE_API_URL=https://cloudcost-api-3uy5.onrender.com
