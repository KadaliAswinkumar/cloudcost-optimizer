# Local Vite dev (optional overrides)
# UI port — default 5174 (project avoids 5173 which is often used by other apps)
# VITE_UI_PORT=5174

# Where to proxy /api and /health (FastAPI). Default: backend on 8000
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Production / CI build only: full API URL (GitHub Pages, etc.)
# VITE_API_URL=https://your-api.onrender.com
