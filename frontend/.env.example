# Local Vite dev (optional overrides)
# UI port — default 8080 (API on 8801; no 5xxx ports)
# VITE_UI_PORT=8080

# Where to proxy /api and /health (FastAPI). Default: backend on 8801
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8801

# Production / CI build only: full API URL (GitHub Pages, etc.)
# VITE_API_URL=https://your-api.onrender.com
