5.3 Rate Limiting Middleware (middleware/rate_limiter.py)
class RateLimiterMiddleware(BaseHTTPMiddleware):    async def dispatch(self, request, call_next):        client_id = self._get_client_id(request)  # IP address                # Check rate limit using Redis sliding window        is_allowed, remaining = await self._check_rate_limit(client_id)                if not is_allowed:            raise HTTPException(                status_code=429,                detail="Rate limit exceeded",                headers={"Retry-After": "60"},            )                response = await call_next(request)        response.headers["X-RateLimit-Remaining"] = str(remaining)        return response
Algorithm: Sliding Window
Track requests in Redis sorted set
Each request adds timestamp
Count requests in last 60 seconds
Reject if over limit
